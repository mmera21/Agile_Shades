<% content_for :title, "Shade #{@color.hex_value}" %>
<%# RUBRIC 3.4 — many-to-many navigation: Color -> every product with this shade %>
<div class="row g-5 mb-4">
  <div class="col-md-3">
    <div class="swatch-hero" style="background-color: <%= @color.hex_value %>;"></div>
  </div>
  <div class="col-md-9">
    <p class="label mb-2">Shade</p>
    <h1 class="mono" style="font-size: clamp(2rem, 5vw, 3.4rem); letter-spacing: 0;"><%= @color.hex_value %></h1>
    <p class="label">Appears in <%= pluralize(@product_colors.size, "product") %></p>
  </div>
</div>

<table class="table table-hover">
  <thead>
    <tr><th scope="col">Name given by brand</th><th scope="col">Product</th><th scope="col">Brand</th></tr>
  </thead>
  <tbody>
    <% @product_colors.each do |pc| %>
      <tr>
        <td><%= pc.colour_name %></td>
        <td><%= link_to pc.product.name, product_path(pc.product) %></td>
        <td><%= link_to pc.product.brand.display_name, brand_path(pc.product.brand) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
