<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | Shade Finder" : "Shade Finder" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# RUBRIC 5.3 — Bootstrap 5 CSS framework (loaded from CDN); custom look in application.css %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..500;1,9..144,300..500&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=IBM+Plex+Sans:wght@400;500&amp;display=swap">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%# RUBRIC 2.2 — Menu present on ALL pages (it lives in the layout) %>
    <%= render "shared/navbar" %>

    <%# RUBRIC 5.3 — Bootstrap grid: every page is inside .container > .row > .col %>
    <main class="container py-4 flex-grow-1">
      <%= yield %>
    </main>

    <footer class="colophon mt-5">
      <div class="container d-flex flex-wrap justify-content-between py-3 gap-2">
        <span>Shade Finder — Rails Intro Project</span>
        <span>Data: <a href="https://makeup-api.herokuapp.com/">Makeup API</a> + Faker</span>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
